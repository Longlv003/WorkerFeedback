{
  "name": "worker-feedback-root",
  "private": true,
  "scripts": {
    "setup:termux": "node scripts/setup-termux.cjs",
    "check:sqlite": "node scripts/check-sqlite.cjs",
    "predev:backend": "npm run build:shared",
    "dev:backend": "npm run dev --prefix backend",
    "predev:frontend": "npm run build:shared",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:shared": "npm run build --prefix packages/shared",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend"
  },
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
